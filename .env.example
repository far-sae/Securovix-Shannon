# Securovix dashboard — environment variables.
# Copy to `.env` for local dev, OR set these as variables in Railway → Project → Variables.

# ---- Server ----
PORT=3000
NODE_ENV=production

# ---- Session signing (REQUIRED in production) ----
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHANNON_SESSION_SECRET=replace-me-with-a-32-byte-hex-string
# Separate key used to encrypt MFA seeds, scan credentials and connector secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHANNON_ENCRYPTION_KEY=replace-me-with-another-32-byte-hex-string
SHANNON_PUBLIC_URL=https://YOUR-RAILWAY-DOMAIN
SHANNON_REQUIRE_EMAIL_VERIFICATION=1
SHANNON_DURABLE_JOBS=1
SHANNON_CACHE_REFRESH_MS=5000
SHANNON_DB_TIMEOUT_MS=15000
SHANNON_HEADLESS=1

# Comma-separated emails allowed to control process-wide operations such as dashboard self-defense.
SHANNON_PLATFORM_ADMINS=security-admin@example.com

# ---- Supabase (REQUIRED in production — falls back to local JSON files if unset) ----
# From: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service_role key (NEVER expose to the browser)

# ---- Dedicated Railway worker ----
SHANNON_WORKER_CONCURRENCY=2
SHANNON_WORKER_POLL_MS=2500
SHANNON_JOB_STALE_MS=120000
SHANNON_MAX_ARTIFACT_BYTES=104857600
SHANNON_AUTH_TOKEN_RETENTION_DAYS=7
SHANNON_JOB_RETENTION_DAYS=30
SHANNON_DELIVERY_RETENTION_DAYS=90
SHANNON_OPERATIONAL_RETENTION_DAYS=30
SHANNON_ARTIFACT_RETENTION_DAYS=90
# Set only after completing and documenting the corresponding test; refresh on each test date.
SHANNON_BACKUPS_VERIFIED_AT=
SHANNON_ALERTS_VERIFIED_AT=
SHANNON_SECURITY_CONTACT=security@securovix.com

# ---- Separate Defender Edge service ----
# Use the same independent platform token on the Dashboard and Edge services. This token lets the
# shared edge fetch every tenant route; customer SDK keys remain organization-scoped.
SHANNON_DASHBOARD_URL=https://YOUR-RAILWAY-DOMAIN
SHANNON_EDGE_PLATFORM_TOKEN=replace-with-a-different-32-byte-random-token
# Legacy single-organization Edge only. Leave empty for the shared multi-tenant service.
SHANNON_EDGE_API_KEY=
SHANNON_EDGE_REFRESH_MS=60000
# Optional recovery floor if the dashboard is unavailable. JSON array; keep [] when unused.
SHANNON_EDGE_ROUTES=[]

# ---- Dashboard self-defense ----
SHANNON_DEFEND_SELF=1
SHANNON_DEFEND_SELF_MODE=monitor

# ---- Email (choose Resend or your HTTPS relay) ----
RESEND_API_KEY=
SHANNON_EMAIL_FROM=Securovix Shannon <security@example.com>
SHANNON_EMAIL_WEBHOOK_URL=
SHANNON_EMAIL_WEBHOOK_TOKEN=

# ---- Enterprise identity (legacy platform-wide fallback; prefer per-organization Settings) ----
OIDC_ISSUER=https://login.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_NAME=Company SSO
SHANNON_SSO_ALLOWED_DOMAINS=example.com
SHANNON_SCIM_TOKEN=replace-with-a-long-random-token
SHANNON_SCIM_ORG_ID=org_replace_me

# ---- Stripe billing (optional; checkout remains disabled until required values are present) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
SHANNON_PRO_MONTHLY_GBP=99
SHANNON_PRO_YEARLY_GBP=990

# Protects the Prometheus-compatible /metrics endpoint.
SHANNON_METRICS_TOKEN=replace-with-a-long-random-token

# ---- Dedicated production sandbox runner (optional; never expose Docker to the Dashboard) ----
# URL is Dashboard-only. Put the same runner token on Dashboard and the dedicated Linux VM.
SHANNON_SANDBOX_RUNNER_URL=https://sandbox-runner.example.com
SHANNON_SANDBOX_RUNNER_TOKEN=replace-with-a-different-32-byte-random-token
# Runner-VM-only. Keep small for predictable isolation.
SHANNON_SANDBOX_MAX_CONCURRENT=2

# ---- Google OAuth (OPTIONAL) ----
# From: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: https://YOUR-RAILWAY-URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- LLM keys (OPTIONAL — users normally bring their own in the UI) ----
# Server-side fallback only, mostly useful for headless CI testing.
ANTHROPIC_API_KEY=
# In production, platform AI keys are disabled by default so customers cannot spend your key.
SHANNON_ALLOW_PLATFORM_AI_KEYS=0
SHANNON_MODEL=claude-opus-4-7
SHANNON_QUICK_MODEL=claude-sonnet-4-6
