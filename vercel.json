{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'Static-only — Vercel serves packages/dashboard/public/ and rewrites /api/* + /auth/* to Railway.'",
  "outputDirectory": "packages/dashboard/public",
  "framework": null,
  "trailingSlash": false,

  "rewrites": [
    { "source": "/api/:path*",   "destination": "https://REPLACE-WITH-RAILWAY-URL.up.railway.app/api/:path*" },
    { "source": "/auth/:path*",  "destination": "https://REPLACE-WITH-RAILWAY-URL.up.railway.app/auth/:path*" },
    { "source": "/healthz",      "destination": "https://REPLACE-WITH-RAILWAY-URL.up.railway.app/healthz" }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",     "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/favicon.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, immutable" }]
    },
    {
      "source": "/(tokens|components).css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }]
    }
  ]
}
