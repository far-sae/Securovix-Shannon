# Never ship local installs into the image — Docker installs fresh.
node_modules
**/node_modules
.pnpm-store

# VCS + IDE
.git
.gitignore
.vscode
.idea
*.swp

# Local secrets / state
.env
.env.*
.shannon-settings.json
*.local.yaml

# Local scan artifacts (the workspaces dir is recreated per-deploy)
workspaces

# Build / cache junk
.turbo
dist
# Rust build output of the Guard agent (gigabytes locally; the image builds its own copy)
packages/guard-agent/target
packages/guard-agent/dist
*.log
.DS_Store
