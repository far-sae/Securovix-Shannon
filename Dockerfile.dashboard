# Securovix dashboard — production image for Railway.
#
# Strategy: install the dashboard's deps directly via npm (it already ships
# its own package-lock.json), bypassing pnpm-workspace symlink complexity.
# This keeps node_modules flat and predictable so Node's ESM resolver finds
# `express` etc. without any workspace gymnastics.

FROM node:20-alpine
WORKDIR /app

# 1) Copy ONLY the dashboard's manifests first — keeps Docker cache hot
#    when only source code changes.
COPY packages/dashboard/package.json      /app/packages/dashboard/package.json
COPY packages/dashboard/package-lock.json /app/packages/dashboard/package-lock.json

# 2) Install production deps inside packages/dashboard (NOT a workspace install).
#    `npm ci` requires the lock file and is reproducible + faster than `npm install`.
RUN cd packages/dashboard && npm ci --omit=dev

# 2b) The dashboard spawns `node /app/run-scan.mjs` (the legacy pentest pipeline,
#     which lives at the repo root). Node's ESM resolver only walks UP from the
#     spawned file, so it looks for /app/node_modules — not /app/packages/dashboard/node_modules.
#     Install run-scan.mjs's two deps into /app/node_modules so the child process
#     can actually load. Without this, the spawn dies on `import "yaml"` and the
#     "New Scan" button silently does nothing.
RUN npm install --omit=dev --no-package-lock yaml@^2.4.0 @anthropic-ai/sdk@^0.126.0

# 3) Copy the rest of the workspace AFTER install. The .dockerignore prevents
#    any local node_modules from clobbering the freshly installed ones.
COPY . .

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

# Railway sets PORT automatically; the dashboard reads process.env.PORT.
CMD ["node", "packages/dashboard/server.mjs"]
