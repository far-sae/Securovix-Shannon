# Securovix dashboard — production image for Railway.
#
# Builds from the package root. Includes the full pnpm workspace because the
# dashboard imports from sibling packages (@shannon/cli, @shannon/worker) and
# the run-scan.mjs entry point lives at the workspace root.

FROM node:20-alpine AS base
WORKDIR /app

# pnpm via corepack — no global install needed.
RUN corepack enable && corepack prepare pnpm@latest --activate

# 1) Install workspace deps (only manifests for cache friendliness)
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY packages/cli/package.json       packages/cli/package.json
COPY packages/worker/package.json    packages/worker/package.json
COPY packages/dashboard/package.json packages/dashboard/package.json
RUN pnpm install --frozen-lockfile --prod=false

# 2) Copy source
COPY . .

# 3) Runtime
ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

# Railway sets PORT automatically; the dashboard reads process.env.PORT.
CMD ["node", "packages/dashboard/server.mjs"]
