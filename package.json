{
  "name": "shannon-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "web": "node web/server.mjs",
    "test": "node --test ./engine.test.mjs ./templates.test.mjs ./crawler.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "undici": "^8.2.0",
    "yaml": "^2.4.0"
  },
  "optionalDependencies": {
    "playwright": "^1.48.0"
  }
}
